# deploy/app/server.env · deploy/admin/server.env 의 틀. 두 폴더에 복사해서 값을 채운다 (커밋 금지, .gitignore 에 있음)
# 항목 설명은 server/.env.example 과 같다. APP_ROLE·NODE_ENV 는 docker-compose.yml 이 정한다

# 데이터 서버 사설 IP 로
DATABASE_URL=postgres://savetime:<POSTGRES_PASSWORD>@<데이터 서버 사설 IP>:5432/savetime
REDIS_URL=redis://:<REDIS_PASSWORD>@<데이터 서버 사설 IP>:6379

# 주의: 값이 빈 줄 뒤에 설명(# ...)을 붙이지 말 것. docker compose 는 '키=   # 설명' 의 설명 글을 값으로 읽는다
#       설명은 늘 윗줄에 쓴다 (서버도 '#'로 시작하는 값이 있으면 켜지지 않는다)

# 앱 서버와 관리자 서버가 같은 값이어야 한다 (관리자 서버가 보내는 정지 알림·토큰 확인)
# 무작위 32바이트 이상: openssl rand -base64 32
JWT_SECRET=
SHIFT_MAX_HOURS=14
# 앱 최소 지원 버전 (SFR-142). 서버가 바뀌어 옛 앱과 맞지 않으면 올린다
MIN_APP_VERSION=1.0.0

# 병원·관리자 웹 주소 (https://앱 도메인, https://admin.앱 도메인)
ALLOWED_ORIGINS=
# 구급대원 웹앱 주소 (앱 서버만, CR-010)
APP_ORIGINS=
# 관리자 서버만: 접속 허용 IP (쉼표). 비우면 관리자 서버가 켜지지 않는다
ADMIN_ALLOWED_IPS=

PUBLIC_DATA_API_KEY=
PUBLIC_DATA_DAILY_LIMIT=10000
COLLECT_REGIONS=
# 앱 서버만 (길찾기·주소)
KAKAO_REST_API_KEY=
KAKAO_DIRECTIONS_DAILY_LIMIT=10000
KAKAO_LOCAL_DAILY_LIMIT=100000
ROUTE_RADIUS_KM=10
FIREBASE_SERVICE_ACCOUNT_BASE64=

S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PHOTO_ENC_KEY=

# 구급활동일지 AI 정리 (SFR-167)
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000

SENTRY_DSN=

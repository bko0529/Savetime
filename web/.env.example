# admin 이면 /admin 만, 그 밖의 값(비움 포함)이면 /hospital 만 켜요 (COR-008, T-11)
APP_ROLE=

# 개발 중 /api/* 를 넘길 서버 주소 (비우면 http://localhost:4000)
API_ORIGIN=

# 개발 중 실시간 연결(Socket.IO)을 붙을 서버 주소. 운영에서는 비워 둬요(같은 도메인). 예: http://localhost:4000
NEXT_PUBLIC_SOCKET_ORIGIN=

# 카카오 지도 JavaScript 키 (카카오 디벨로퍼스 > 앱 키 > JavaScript 키). 관리자 응급실 입구 좌표 지정 (SFR-145).
# 플랫폼 > Web 사이트 도메인에 http://localhost:3000·운영 주소를 등록해야 동작. 비우면 위도·경도 직접 입력
NEXT_PUBLIC_KAKAO_JS_KEY=

# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. .env 는 절대 커밋하지 않아요. (SER-001)
# 새 키가 생기면 여기에 "이름만" 추가해요.

# ---- 기본 ----
NODE_ENV=development
PORT=4000
APP_ROLE=main                 # main = 대원·병원 API / admin = 관리자 서버 (T-11)
DATABASE_URL=postgres://savetime:savetime_local@localhost:5432/savetime
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_ALLOWED_IPS=127.0.0.1   # 관리자 서버 접속 허용 IP (쉼표로 여러 개)

# ---- 인증 ----
JWT_SECRET=
SHIFT_MAX_HOURS=14            # 근무 단위 로그인 최대 시간 (SER-007, D-110)

# ---- 공공 응급의료 API (개발·운영 키 분리) ----
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_DAILY_LIMIT=10000 # 공공 API 하루 호출 한도. 증량되면 이 값만 바꿈 (SFR-090)
COLLECT_REGIONS=충청남도      # 개발은 1곳만. 운영은 비워 두면 전국 17개 (T-07)

# ---- 카카오 ----
KAKAO_REST_API_KEY=           # 비워 두면 예상 이동시간만 빠지고(SFR-073) 주소→좌표는 503 (SFR-009)
KAKAO_DIRECTIONS_DAILY_LIMIT=10000 # 자동차 길찾기 하루 무료량 (ASM-12)
KAKAO_LOCAL_DAILY_LIMIT=100000 # 카카오 로컬(주소 검색) 하루 무료량
ROUTE_RADIUS_KM=10            # 요청 때 길찾기 쓰는 반경 (ASM-12)

# ---- 푸시 (FCM) ----
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON 파일을 base64 한 줄로 (macOS: base64 -i 키.json | tr -d '\n')
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- 객체 저장소 (공무원증 사진) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PHOTO_ENC_KEY=                # AES-256-GCM 키 (32바이트, base64)

# ---- AI (구급활동일지 정리, 제공사는 S6 전 결정) ----
AI_API_KEY=
AI_TIMEOUT_MS=10000

# ---- 오류 수집 ----
SENTRY_DSN=

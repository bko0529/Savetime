# 앱 설정 이름만 적어요. 실제 값은 .env.local 에 (커밋하지 않음)
# 서버 주소 (비밀 아님). 없으면 http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=
# 카카오 JavaScript 키: 카카오 지도(WebView)용. 카카오 콘솔에서 플랫폼 도메인으로 제한된 키
EXPO_PUBLIC_KAKAO_JS_KEY=
# 시연 고정 위치 (선택)
EXPO_PUBLIC_FIXED_LAT=
EXPO_PUBLIC_FIXED_LNG=
# 카카오 네이티브 앱 키: 카카오내비 SDK(개발 빌드)용. 카카오 콘솔에서 번들 ID·패키지명으로 제한된 키
KAKAO_NATIVE_APP_KEY=
